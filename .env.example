# HyperDrop Client Environment Configuration Template
# Copy this file to '.env.local' or '.env.production' and populate the values

# The public HTTP/WS URL of your deployed Render backend (Socket.IO & API server)
# Example: https://hyperdrop-tzjv.onrender.com
VITE_SOCKET_URL=

# Optional: Discord Webhook URL for transfer ratings & performance telemetry
VITE_DISCORD_WEBHOOK_URL=
